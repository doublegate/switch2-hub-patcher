# Firmware: dumps, patched images and their manifests are vendor property and
# never belong in the repository. Report hashes instead.
# Local layout (status and guide use it when present): firmware/stock/ (dumps),
# firmware/patched/ (flashable images + manifests), firmware/candidates/ (untested builds).
# Only firmware/README.md (the layout description) is tracked.
/firmware/*
!/firmware/README.md
*.bin
*.img
*.rom
*-patched.json
*-stock*.json
*.manifest.json

# Vendor tool databases and decoded output (research/rtd_db_dump.py)
DB.bin
DPCDDB.bin
IPDB.bin
ReadAll.txt
fields*.txt
# Labels decoded from them (research/ghidra/db_to_tsv.py); research/rtd2142_symbols.tsv is ours
db-registers.tsv
registers.tsv

# Ghidra projects and exports over firmware (research/ghidra/); vendor-derived
*.gpr
*.rep/
*.gzf
*.lock
*.lock~

# SDCC by-products when assembling in the tree
*.rel
*.ihx
*.hex
*.lst
*.rst
*.sym
*.map
*.mem
*.lk
*.noi
*.adb
*.cdb

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
*.egg
.venv/
venv/
.python-version

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.pyright/
.coverage
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local agent and session state (AGENTS.md / CLAUDE.md are tracked)
CLAUDE.local.md
*.mc-bak

# Antigravity PR reviewer: large-diff on-disk handoff (transient, removed by the script).
/.agy-review-work/
